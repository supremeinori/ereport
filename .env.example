# ==========================================
# E-Report PBOBA - Environment Variables Example
# Sesuai NFR-04: File ini TIDAK boleh memuat nilai rahasia
# ==========================================

# Database URLs (Supabase PostgreSQL via Prisma)
# DATABASE_URL: Transaction Pooler (port 6543) dengan pgbouncer=true untuk runtime serverless
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct Connection (port 5432) untuk migrasi Prisma
DIRECT_URL="postgresql://postgres:[password]@[db-host]:5432/postgres"

# Supabase Storage & API (ARC-04: hanya PostgreSQL dan Object Storage)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="reports"

# Auth & Session Security (SEC-03)
SESSION_SECRET="generate-a-strong-random-secret-at-least-32-chars"

# Initial Admin Bootstrap (SEC-13)
ADMIN_IDENTIFIER="ADMIN-SUMBAR-01"
ADMIN_NAME="Administrator Utama"
ADMIN_EMAIL="admin@pboba-sumbar.go.id"
ADMIN_PASSWORD="change-me-with-a-secure-password"

# Optional: Google Drive Backup (M7)
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""
